---
import Sidebar from "./Sidebar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siGithub, siWechat, siX, siXiaohongshu, siYoutube, siZhihu } from "simple-icons";
import { competitions, education, honors, internships, personal, personalLinks, profile, publications, technicalSkills } from "../data/profile";

const navItems = [
  { href: "#about", en: "About", zh: "关于" },
  { href: "#education", en: "Education", zh: "教育" },
  { href: "#skills", en: "Skills", zh: "技能" },
  { href: "#internships", en: "Internships", zh: "实习" },
  { href: "#publications", en: "Publications", zh: "论文" },
  { href: "#competitions", en: "Competitions", zh: "竞赛经历" },
  { href: "#honors", en: "Honors & Awards", zh: "荣誉奖项" },
  { href: "#personal", en: "Personal", zh: "个人" }
];
const localizePeriod = (period: string) => period.replace("Present", "现在");
const linkedinIcon = {
  path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM3.56 9h3.555v11.452H3.56z"
};
const personalIconMap: Record<string, { path: string }> = {
  WeChat: siWechat,
  GitHub: siGithub,
  LinkedIn: linkedinIcon,
  Zhihu: siZhihu,
  YouTube: siYoutube,
  X: siX,
  Xiaohongshu: siXiaohongshu
};
---

<BaseLayout title={profile.name} description={profile.intro.en.join(" ")}>
  <header class="site-header">
    <button class="home-control" type="button" data-home-trigger aria-expanded="false" aria-controls="profile-sidebar">
      <span data-locale="en">Home</span>
      <span data-locale="zh">主页</span>
    </button>

    <nav class="desktop-sections" aria-label="Profile sections">
      {
        navItems.map((item, index) => (
          <a class:list={["section-link", index === 0 && "active"]} href={item.href} data-section-link>
            <span data-locale="en">{item.en}</span>
            <span data-locale="zh">{item.zh}</span>
          </a>
        ))
      }
    </nav>

    <button class="section-control" type="button" data-section-trigger aria-expanded="false" aria-controls="section-menu">
      <span class="section-control-label">
        <span data-locale="en">Section</span>
        <span data-locale="zh">章节</span>
      </span>
      <span class="section-control-current" data-section-current>About</span>
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m6 8 4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>

    <div class="header-language" aria-label="Language switch">
      <button class="is-active" type="button" data-language-button="en" aria-pressed="true">EN</button>
      <span aria-hidden="true">/</span>
      <button type="button" data-language-button="zh" aria-pressed="false">中文</button>
    </div>

    <nav class="section-menu" id="section-menu" aria-label="Section menu" hidden data-section-menu>
      {
        navItems.map((item, index) => (
          <a
            class:list={["section-menu-link", index === 0 && "active"]}
            href={item.href}
            data-section-link
            data-label-en={item.en}
            data-label-zh={item.zh}
            aria-current={index === 0 ? "location" : undefined}
          >
            <span data-locale="en">{item.en}</span>
            <span data-locale="zh">{item.zh}</span>
          </a>
        ))
      }
    </nav>
  </header>

  <div class="shell">
    <button class="sidebar-backdrop" type="button" data-sidebar-backdrop aria-label="Close profile panel" hidden></button>
    <Sidebar />

    <main class="main" id="main" data-scroll-main>
      <div class="body">
        <section class="sec" id="about">
          <div class="sec-h">
            <span data-locale="en">About</span>
            <span data-locale="zh">关于</span>
          </div>
          {
            profile.intro.en.map((paragraph, index) => (
              <p class="about-p">
                <span data-locale="en">{paragraph}</span>
                <span data-locale="zh">{profile.intro.zh[index]}</span>
              </p>
            ))
          }
          <div class="tags">
            {
              profile.interests.map((interest) => (
                <span class="tag">
                  <span data-locale="en">{interest.en}</span>
                  <span data-locale="zh">{interest.zh}</span>
                </span>
              ))
            }
          </div>
        </section>

        <section class="sec" id="education">
          <div class="sec-h">
            <span data-locale="en">Education</span>
            <span data-locale="zh">教育经历</span>
          </div>
          <div class="tl">
            {
              education.map((item, index) => (
                <div class="tl-row">
                  <div class="tl-spine">
                    <div class:list={["dot", index > 0 && "dot-dim"]}></div>
                    {index < education.length - 1 && <div class="spine-line"></div>}
                  </div>
                  <div class="tl-card">
                    <div class="edu-row">
                      <div class="edu-school">
                        <span data-locale="en">{item.title.en}</span>
                        <span data-locale="zh">{item.title.zh}</span>
                      </div>
                      <div class="edu-period">
                        <span data-locale="en">{item.period}</span>
                        <span data-locale="zh">{localizePeriod(item.period)}</span>
                      </div>
                    </div>
                    <div class="edu-degree">
                      <span data-locale="en">{item.subtitle.en}</span>
                      <span data-locale="zh">{item.subtitle.zh}</span>
                    </div>
                    {item.description && (
                      <div class="edu-desc">
                        <p class="edu-desc-line">
                          <span data-locale="en">{item.description.en}</span>
                          <span data-locale="zh">{item.description.zh}</span>
                        </p>
                      </div>
                    )}
                    {item.descriptionItems && (
                      <div class="edu-desc">
                        {item.descriptionItems.map((description) => (
                          <p class="edu-desc-line">
                            <span data-locale="en">{description.en}</span>
                            <span data-locale="zh">{description.zh}</span>
                          </p>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <section class="sec" id="skills">
          <div class="sec-h">
            <span data-locale="en">Technical Skills</span>
            <span data-locale="zh">技术能力</span>
          </div>
          <dl class="skills-list">
            {
              technicalSkills.map((group) => (
                <div class="skill-row">
                  <dt class="skill-label">
                    <span data-locale="en">{group.label.en}</span>
                    <span data-locale="zh">{group.label.zh}</span>
                  </dt>
                  <dd class="skill-items">
                    {group.items.map((item) => <span class="skill-item">{item}</span>)}
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="sec" id="internships">
          <div class="sec-h">
            <span data-locale="en">Internships</span>
            <span data-locale="zh">实习经历</span>
          </div>
          <div class="tl">
            {
              internships.map((item, index) => (
                <div class="tl-row">
                  <div class="tl-spine">
                    <div class:list={["dot", index > 0 && "dot-dim"]}></div>
                    {index < internships.length - 1 && <div class="spine-line"></div>}
                  </div>
                  <div class="tl-card">
                    <div class="internship-row">
                      <div class="internship-title">
                        <span data-locale="en">{item.title.en}</span>
                        <span data-locale="zh">{item.title.zh}</span>
                      </div>
                      <div class="internship-period">
                        <span data-locale="en">{item.period}</span>
                        <span data-locale="zh">{localizePeriod(item.period)}</span>
                      </div>
                    </div>
                    <div class="internship-position">
                      <span data-locale="en">{item.subtitle.en}</span>
                      <span data-locale="zh">{item.subtitle.zh}</span>
                    </div>
                    {(item.description || item.descriptionItems) && (
                      <div class="internship-descriptions">
                        {item.description && (
                          <p class="internship-description-line">
                            <span data-locale="en">{item.description.en}</span>
                            <span data-locale="zh">{item.description.zh}</span>
                          </p>
                        )}
                        {item.descriptionItems?.map((description) => (
                          <p class="internship-description-line">
                            <span data-locale="en">{description.en}</span>
                            <span data-locale="zh">{description.zh}</span>
                          </p>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <section class="sec" id="publications">
          <div class="sec-h">
            <span data-locale="en">Publications</span>
            <span data-locale="zh">论文</span>
          </div>
          <div class="publication-list">
            {
              publications.map((publication) => (
                <article class="publication-card">
                  <div class="publication-accent" aria-hidden="true"></div>
                  <div class="publication-entry">
                    <div class="publication-heading">
                      <div class="publication-title">
                        <span data-locale="en">{publication.title.en}</span>
                        <span data-locale="zh">{publication.title.zh}</span>
                      </div>
                    </div>
                    <div class="publication-authors">
                      {publication.authors.map((author, index) => (
                        <>
                          <span class={author === profile.name ? "publication-author-self" : undefined}>{author}</span>
                          {index < publication.authors.length - 1 && <span>, </span>}
                        </>
                      ))}
                    </div>
                    <div class="publication-resources">
                      {
                        publication.pdf ? (
                          <a class="publication-resource-link publication-pdf-link" href={publication.pdf} target="_blank" rel="noopener noreferrer">
                            <svg class="publication-resource-icon" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M5.25 2.25h5.1l2.4 2.4v11.1h-7.5V2.25Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/><path d="M10.25 2.5v2.75H13M7.1 9h3.8M7.1 11.5h3.8" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span>PDF</span>
                          </a>
                        ) : (
                          <span class="publication-resource-link publication-pdf-link is-unavailable" aria-disabled="true">
                            <svg class="publication-resource-icon" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M5.25 2.25h5.1l2.4 2.4v11.1h-7.5V2.25Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/><path d="M10.25 2.5v2.75H13M7.1 9h3.8M7.1 11.5h3.8" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span>PDF</span>
                          </span>
                        )
                      }
                      {
                        publication.code ? (
                          <a class="publication-resource-link publication-code-link" href={publication.code} target="_blank" rel="noopener noreferrer">
                            <svg class="publication-resource-icon" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="m6.75 5.75-3 3.25 3 3.25M11.25 5.75l3 3.25-3 3.25M10 3.75 8 14.25" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span>Code</span>
                          </a>
                        ) : (
                          <span class="publication-resource-link publication-code-link is-unavailable" aria-disabled="true">
                            <svg class="publication-resource-icon" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="m6.75 5.75-3 3.25 3 3.25M11.25 5.75l3 3.25-3 3.25M10 3.75 8 14.25" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span>Code</span>
                          </span>
                        )
                      }
                      <div class="publication-period-venue">
                        {publication.year}
                        <span> · </span>
                        <span data-locale="en">{publication.venue.en}</span>
                        <span data-locale="zh">{publication.venue.zh}</span>
                      </div>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section class="sec" id="competitions">
          <div class="sec-h">
            <span data-locale="en">Competitions</span>
            <span data-locale="zh">竞赛经历</span>
          </div>
          <ul class="award-list">
            {
              competitions.map((item) => (
                <li class="award-item">
                  <div class="award-name">
                    <span data-locale="en">{item.title.en}</span>
                    <span data-locale="zh">{item.title.zh}</span>
                  </div>
                  <div class="award-yr">{item.period}</div>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="sec" id="honors">
          <div class="sec-h">
            <span data-locale="en">Honors & Awards</span>
            <span data-locale="zh">荣誉奖项</span>
          </div>
          <ul class="award-list">
            {
              honors.map((item) => (
                <li class="award-item">
                  <div class="award-name">
                    <span data-locale="en">{item.title.en}</span>
                    <span data-locale="zh">{item.title.zh}</span>
                  </div>
                  <div class="award-yr">{item.period}</div>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="sec personal-section" id="personal">
          <div class="sec-h">
            <span data-locale="en">Personal</span>
            <span data-locale="zh">个人</span>
          </div>
          <div class="personal-copy">
            <p class="personal-life">
              <span data-locale="en">{personal.life.en}</span>
              <span data-locale="zh">{personal.life.zh}</span>
            </p>
            <div class="personal-collaboration">
              <div class="personal-kicker">
                <span data-locale="en">Open to conversation</span>
                <span data-locale="zh">期待交流</span>
              </div>
              <p>
                <span data-locale="en">{personal.collaboration.en}</span>
                <span data-locale="zh">{personal.collaboration.zh}</span>
              </p>
            </div>
          </div>
          <div class="personal-links" aria-label="Elsewhere">
            <span class="personal-links-label">
              <span data-locale="en">Elsewhere</span>
              <span data-locale="zh">其他平台</span>
            </span>
            {personalLinks.map((item) => item.label === "WeChat" ? (
              <button class="personal-link" type="button" aria-label="WeChat" title="WeChat" aria-controls="wechat-dialog" aria-expanded="false" data-wechat-trigger>
                <span class="personal-link-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d={personalIconMap[item.label].path}></path></svg>
                </span>
              </button>
            ) : (
              <a class="personal-link" href={item.url} target={item.label === "Email" ? undefined : "_blank"} rel={item.label === "Email" ? undefined : "noopener noreferrer"} aria-label={item.label} title={item.label}>
                <span class="personal-link-icon" aria-hidden="true">
                  {item.label === "Email" ? (
                    <svg class="personal-email-icon" viewBox="0 0 24 24" fill="none"><path d="M3.75 6.75h16.5v10.5H3.75zM3.75 7l7.07 5.02a2 2 0 0 0 2.36 0L20.25 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  ) : (
                    <svg viewBox="0 0 24 24"><path d={personalIconMap[item.label].path}></path></svg>
                  )}
                </span>
              </a>
            ))}
          </div>
        </section>
      </div>
    </main>
  </div>

  <div class="wechat-modal" id="wechat-dialog" hidden data-wechat-modal role="dialog" aria-modal="true" aria-labelledby="wechat-dialog-title">
    <button class="wechat-modal-backdrop" type="button" tabindex="-1" aria-label="Close WeChat QR code" data-wechat-backdrop></button>
    <div class="wechat-dialog-panel">
      <button class="wechat-dialog-close" type="button" aria-label="Close WeChat QR code" data-wechat-close>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
      </button>
      <h2 id="wechat-dialog-title">WeChat</h2>
      <img src="/wechat_id_code.jpg" alt="WeChat QR code for Yuhang Yang" />
      <p>
        <span data-locale="en">Scan the QR code to add me on WeChat.</span>
        <span data-locale="zh">扫描二维码添加我的微信。</span>
      </p>
    </div>
  </div>
</BaseLayout>
